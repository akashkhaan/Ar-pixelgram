# Pixelgram backend extra secrets — server par /opt/pixelgram/docker/.env me merge karo
# (install.sh ke baad ye values wahan paste karo)

# Admin account (migrate/ensure-admin.mjs use karta hai)
ADMIN_EMAIL=arpixelgram@gmail.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Firebase push notifications (pura service account JSON, ek line me)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:arpixelgram@gmail.com

# SMS OTP (Twilio) — optional, phone signup ke liye
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=

# Email (Resend) — optional, password reset ke liye
RESEND_API_KEY=

# Migration ke waqt purane Supabase ki info (migrate scripts use karte hain)
OLD_SUPABASE_URL=https://jfizzduvmzavtqwzqacy.supabase.co
OLD_SUPABASE_SERVICE_KEY=
NEW_SUPABASE_URL=
NEW_SUPABASE_SERVICE_KEY=
